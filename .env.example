# Server-only credentials. Never commit .env.
# Eve routes string model IDs through Vercel AI Gateway. On Vercel, OIDC is enough;
# locally or off-Vercel, set a gateway key.
AI_GATEWAY_API_KEY=
# Optional public-web search and extraction.
PARALLEL_API_KEY=
BROWSERBASE_API_KEY=
# Optional: the project can be inferred from the Browserbase API key.
BROWSERBASE_PROJECT_ID=
BELL_MODEL=openai/gpt-6-luna
BELL_DEMO_URL=https://bell-stack-demo-site.vercel.app/protected
STAGEHAND_BROWSER=browserbase
# Hosted browser logging and recording are always disabled.
# Optional browser runtime features:
# Local handoff only. For phone use, set this to Bell's deployed HTTPS origin.
BELL_PUBLIC_URL=http://127.0.0.1:4320
BELL_HANDOFF_SECRET=
# Optional HTTP Basic access for one trusted operator; password must be at least 32 bytes.
BELL_OPERATOR_USERNAME=
BELL_OPERATOR_PASSWORD=
# Existing local encrypted vault files remain readable; no vault-writing API is provided.
BELL_VAULT_FILE=.bell/vault.enc.json
BELL_VAULT_MASTER_KEY=
# Optional Linq messaging. Keep tokens and your personal number in .env.local.
LINQ_API_KEY=
LINQ_WEBHOOK_SECRET=
# Your Linq receiving line in E.164 format, starting with + and country code.
BELL_LINQ_PHONE_NUMBER=
# Comma-separated E.164 numbers. Empty accepts nobody.
BELL_LINQ_ALLOWED_SENDERS=

# PostgreSQL for Notion memory and optional Parallel watches.
# Use a direct or session-pooled connection; transaction-mode poolers do not
# preserve the session advisory locks used for token rotation.
DATABASE_URL=

# Personal memory and notes through Notion MCP.
# Apply migrations/006_notion.sql using DATABASE_URL.
# OAuth clients are registered automatically; no Notion API token is needed.
# Generate once with openssl rand -base64 32; keep stable across workers/restarts.
NOTION_TOKEN_ENCRYPTION_KEY=

# Optional persistent public-web watches. Apply migrations/004_parallel_monitors.sql and 005_monitor_frequency.sql.
# Copy the Parallel organization's secret from Settings > Webhooks.
PARALLEL_WEBHOOK_SECRET=
# Generate a random worker bearer secret; configure a scheduler separately.
CRON_SECRET=
